{
  "name": "@realtime/analytics-sdk",
  "version": "1.0.0",
  "description": "Real-time analytics tracking SDK for web applications",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "start:server": "node server/index.js",
    "dev:server": "nodemon server/index.js"
  },
  "keywords": [
    "analytics",
    "tracking",
    "real-time",
    "sdk",
    "javascript",
    "nodejs"
  ],
  "author": "Realtime Analytics Team",
  "license": "MIT",
  "dependencies": {
    "uuid": "^9.0.0",
    "crypto-js": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@types/crypto-js": "^4.1.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "nodemon": "^3.0.0",
    "rollup": "^3.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "typescript": "^5.0.0",
    "ts-jest": "^29.0.0"
  },
  "peerDependencies": {
    "express": "^4.18.0",
    "socket.io": "^4.7.0",
    "mongoose": "^7.0.0",
    "redis": "^4.6.0"
  }
}